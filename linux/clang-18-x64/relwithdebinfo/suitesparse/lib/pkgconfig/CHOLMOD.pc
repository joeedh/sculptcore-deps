prefix=/home/runner/work/sculptcore-blender-addon/sculptcore-blender-addon/engine/extern/sculptcore-deps/linux/clang-18-x64/relwithdebinfo/suitesparse
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/suitesparse

Name: CHOLMOD
URL: https://github.com/DrTimothyAldenDavis/SuiteSparse
Description: Routines for factorizing sparse symmetric positive definite matrices in SuiteSparse
Version: 5.3.4
Requires.private: SuiteSparse_config AMD COLAMD  CAMD CCOLAMD
Libs: -L${libdir} -lcholmod
Libs.private:  -lomp /lib/x86_64-linux-gnu/libpthread.a -lm -lopenblas -lopenblas
Cflags: -I${includedir} 
